{
  "name": "agentbase-desktop",
  "private": true,
  "version": "0.7.7",
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "start": "electron .",
    "stage": "node ../scripts/stage-desktop.mjs",
    "build:windows": "npm run stage && electron-builder --win appx zip --x64",
    "build:windows-zip:cross": "AGENTBASE_DESKTOP_TARGET=win32 npm run stage && electron-builder --win zip --x64 --config.directories.output=../build/windows-cross",
    "build:mac": "npm run stage && electron-builder --mac zip --config.directories.output=../build/mac-shared"
  },
  "build": {
    "appId": "dev.agentbase.inspector",
    "productName": "AgentBase",
    "files": [
      "main.mjs",
      "connection-actions.mjs",
      "memory-actions.mjs",
      "analysis-view.mjs",
      "preload.cjs",
      "index.html",
      "renderer.js",
      "view-model.mjs",
      "style.css",
      "assets/**"
    ],
    "extraResources": [
      {
        "from": "build-resources/package",
        "to": "package"
      }
    ],
    "directories": {
      "output": "../build/windows",
      "buildResources": "assets"
    },
    "toolsets": {
      "winCodeSign": "1.1.0"
    },
    "win": {
      "target": [
        "appx"
      ],
      "icon": "assets/app-icon.png"
    },
    "mac": {
      "target": ["zip"],
      "icon": "assets/app-icon.png"
    },
    "appx": {
      "applicationId": "AgentBase",
      "identityName": "Duncanai.AgentBase",
      "publisher": "CN=4F992D36-6A62-40AB-898D-7C11A16F0FA7",
      "publisherDisplayName": "Duncanai",
      "displayName": "AgentBase"
    }
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  }
}
